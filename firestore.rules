rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The owner's User UID (Firebase console → Authentication → Users). Must match ownerUid in public/js/firebase-config.js.
    function isOwner() { return request.auth != null && request.auth.uid == "ckeR0bMZrUd86prT4f8XFI7FQsk2"; }

    // Each person can read and write only their own passport: users/{uid}/stamps (one dated doc per site)
    // and /meta (their NPS API key).
    match /users/{uid}/{collection}/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && collection in ['stamps', 'meta']
        && request.resource.data.keys().size() < 20;
    }

    // The park list everyone uses. Anyone signed in can read it; only the owner can refresh it.
    match /shared/{docId} {
      allow read: if request.auth != null;
      allow delete: if isOwner();
      allow create, update: if isOwner() && docId == 'units'
        && request.resource.data.keys().size() < 10
        && request.resource.data.json is string && request.resource.data.json.size() < 900000;
    }
  }
}
